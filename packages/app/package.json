{
  "name": "argelanderspace",
  "version": "0.2.1",
  "description": "A local research workspace you share with your AI agent: read and annotate papers (PDF and arXiv LaTeX), a citation-graph library with NASA ADS discovery, argument graphs, plans and a LaTeX writer, with a Copilot and a CLI for agents such as Claude Code.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HerculeWu/argelanderspace.git"
  },
  "keywords": [
    "research",
    "workspace",
    "ai-agent",
    "copilot",
    "claude-code",
    "literature",
    "papers",
    "pdf",
    "annotation",
    "citation-graph",
    "nasa-ads",
    "arxiv",
    "latex",
    "argument-map",
    "astronomy"
  ],
  "bin": {
    "argelanderspace": "./dist/bin.js"
  },
  "files": [
    "dist",
    "licenses"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "prepack": "node scripts/check-pack.mjs",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@napi-rs/keyring": "2.1.0"
  },
  "devDependencies": {
    "@argelanderspace/cli": "workspace:*",
    "@argelanderspace/server": "workspace:*",
    "@argelanderspace/web": "workspace:*",
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
