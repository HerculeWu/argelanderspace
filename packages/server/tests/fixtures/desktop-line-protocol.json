{
  "version": 1,
  "note": "The line protocol between the desktop host (server desktop-host.ts) and the shell (packages/desktop, Rust), read by both sides' tests: server tests/desktop-line-protocol.test.ts and packages/desktop src/protocol.rs and src/supervisor.rs. Test data only, synthetic values; a too_long line is made by each side from lineMaxBytes. Docs: docs/architecture.md 桌面宿主「行协议」.",
  "constants": {
    "lineMaxBytes": 65536,
    "logLevels": [
      "debug",
      "info",
      "warn",
      "error"
