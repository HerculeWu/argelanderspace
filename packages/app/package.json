{
  "name": "argelanderspace",
  "version": "0.1.0",
  "description": "Ingest arXiv LaTeX sources into a structured render IR, manage a citation-graph library, and read in a local web workspace.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HerculeWu/argelanderspace.git"
  },
  "keywords": [
    "literature",
    "papers",
    "citation-graph",
    "arxiv",
    "latex",
    "astronomy"
  ],
  "bin": {
    "argelanderspace": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/pdfium": "2.15.1"
  },
  "devDependencies": {
    "@argelanderspace/cli": "workspace:*",
    "@argelanderspace/server": "workspace:*",
    "@argelanderspace/web": "workspace:*",
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
