# Private local specs, tickets, discussions and machine-specific notes.
# This directory is deliberately not part of the public repository backup.
.scratch/

# Generated ingestion outputs (regenerable; large binaries / fetch cache).
# The PDF sample under literatures/output/2603.03522 was committed earlier and
# stays tracked; this only ignores newly-generated artifacts (HTML docs, .htmlcache).
literatures/output/

# Library: local literature store + API enrichment cache (user data / regenerable)
literatures/library/

# Job runner runtime state (spooled uploads, job history)
literatures/jobs/

# arXiv auto-ingest failure log (user data / iteration reference; Stage 15)
literatures/logs/

# Document annotations (user data; Stage 8)
literatures/annotations/

# Writer manuscripts + user/agent templates (user data; Stage 10)
literatures/manuscripts/
literatures/templates/

# Plan page store (user data; Stage 4)
status/

