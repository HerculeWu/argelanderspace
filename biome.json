{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["packages/**", "!**/tests/fixtures/**/*.html"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/tests/fixtures/**"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    },
    {
      "includes": ["packages/web/**"],
      "formatter": { "enabled": false },
      "assist": { "actions": { "source": { "organizeImports": "off" } } },
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off",
            "noNonNullAssertion": "off",
            "useConst": "off",
            "useImportType": "off",
            "noDescendingSpecificity": "off"
          },
          "suspicious": {
            "useIterableCallbackReturn": "off",
            "noArrayIndexKey": "off",
            "noShadowRestrictedNames": "off",
            "noAssignInExpressions": "off",
            "noGlobalIsFinite": "off",
            "noExplicitAny": "off"
          },
          "correctness": { "useExhaustiveDependencies": "off" },
          "complexity": { "noImportantStyles": "off", "useOptionalChain": "off" },
          "security": { "noDangerouslySetInnerHtml": "off" },
          "a11y": {
            "useButtonType": "off",
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off",
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  }
}
