      "quit",
      "input_closed",
      "output_closed",
      "signal",
      "switch"
    ],
    "requestKinds": [
      "pick_folder",
      "open_in_browser",
      "open_devtools",
      "open_log_folder",
      "open_config_file",
      "open_skills_folder"
    ],
    "menuRequests": [
      "pick_folder",
      "open_in_browser",
      "open_devtools"
    ],
    "rejectReasons": [
      "too_long",
      "not_json",
      "unknown_type",
      "bad_shape",
      "unknown_id",
      "unknown_event"
    ],
    "shellLineRejectReasons": [
      "too_long",
      "not_utf8"
    ]
  },
