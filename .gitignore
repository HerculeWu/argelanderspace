# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Node / frontend build
node_modules/
packages/*/dist/
*.tsbuildinfo
*.log

# M6 bundle package: copied into packages/app at build time (sources of
# truth live at the repo root — see packages/app/scripts/copy-assets.mjs)
packages/app/README.md
packages/app/LICENSE

# Tooling / indexes
.codegraph/
.serena/

# Local copy of third-party agent skills (Matt Pocock skills; Claude uses the plugin)
/.pi/skills/

# Private local specs, tickets, discussions and machine-specific notes.
# This directory is deliberately not part of the public repository backup.
.scratch/

# Local icon source library; only selected, reviewed resources are vendored.
/svglib/

# Generated ingestion outputs (regenerable; large binaries / fetch cache).
# The PDF sample under literatures/output/2603.03522 was committed earlier and
# stays tracked; this only ignores newly-generated artifacts (HTML docs, .htmlcache).
literatures/output/

# Library: local literature store + API enrichment cache (user data / regenerable)
literatures/library/

# Job runner runtime state (spooled uploads, job history)
literatures/jobs/

# arXiv auto-ingest failure log (user data / iteration reference; Stage 15)
literatures/logs/

# Document annotations (user data; Stage 8)
literatures/annotations/

# Writer manuscripts + user/agent templates (user data; Stage 10)
literatures/manuscripts/
literatures/templates/

# Argument graphs: Work-owned project data (ADR 0009)
literatures/argument-graphs/

# Copilot conversations and native session history (user data; Copilot 07)
literatures/copilot/

# Plan page store (user data; Stage 4)
status/
# ...but the tutorial sample's plan file is part of the committed sample (in-app-tutorial ticket 16).
!/tutorial-sample/status/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
literatures.*-backup.tar.gz

# local npm pack output (ticket 33: never tracked)
packages/app/*.tgz

# The app package's version, written into the CLI's source at build time (packages/cli/scripts/app-version.mjs;
# desktop-app ticket 16): change the version in packages/app/package.json, never here.
packages/cli/src/generated/

# Desktop shell (desktop-app ticket 20): Rust build output and the schemas tauri-build generates on every build.
packages/desktop/target/
packages/desktop/gen/
