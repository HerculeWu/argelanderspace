{
  "name": "@argelanderspace/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/tex/argelander.sty', 'dist/tex/argelander.sty')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@argelanderspace/contracts": "workspace:*",
    "@argelanderspace/core": "workspace:*",
    "@napi-rs/keyring": "2.1.0",
    "env-paths": "^4.0.0",
    "imapflow": "2.2.7",
    "nodemailer": "10.0.15",
    "postal-mime": "4.0.4",
    "proper-lockfile": "4.1.2",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.19.17",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
